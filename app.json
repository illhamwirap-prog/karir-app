{
  "expo": {
    "name": "Karir",
    "slug": "karir",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1E2A22"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.karir.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E2A22"
      },
      "package": "com.karir.app"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
